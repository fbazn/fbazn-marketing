      ]
    },
    "Stripe Transfer": { "main": [[{ "node": "Create Payout Record", "type": "main", "index": 0 }]] },
    "Create Payout Record": { "main": [[{ "node": "Mark Commissions Paid", "type": "main", "index": 0 }]] },
    "Mark Commissions Paid": { "main": [[{ "node": "Update Affiliate Balance", "type": "main", "index": 0 }]] },
    "Update Affiliate Balance": { "main": [[{ "node": "Send Payout Email", "type": "main", "index": 0 }]] },
    "Send Payout Email": { "main": [[{ "node": "Loop Affiliates", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null
}
